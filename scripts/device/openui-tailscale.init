#!/bin/sh /etc/rc.common
# OpenUI-managed Tailscale daemon only; sign-in, modes and routes belong to the
# authenticated agent (agent/src/tailscale.rs). Started by start_zte_agent.sh at
# boot: this firmware's procd does not run custom /etc/rc.d links.
START=99
STOP=10
USE_PROCD=1

# Programs installed by deploy-components.py --tailscale; an older layout keeps working.
BIN=/data/bin
[ -x "$BIN/tailscaled" ] || BIN=/data/mu5250-admin/bin
STATE=/data/tailscale
[ -e /data/mu5250-admin/tailscale/tailscaled.state ] && STATE=/data/mu5250-admin/tailscale

start_service() {
	[ -x "$BIN/tailscaled" ] || return 1
	[ -c /dev/net/tun ] || return 1
	mkdir -p "$STATE" /var/run/tailscale
	chmod 700 "$STATE" /var/run/tailscale
	procd_open_instance
	procd_set_param command "$BIN/tailscaled" \
		--state="$STATE/tailscaled.state" \
		--statedir="$STATE" \
		--socket=/var/run/tailscale/tailscaled.sock \
		--tun=tailscale0 --port=41641
	procd_set_param env TS_DEBUG_FIREWALL_MODE=iptables
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
